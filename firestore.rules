rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'commissioner' ||
        request.auth.token.role == 'officer' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity validation helpers
    function isValidElection(data) {
      return data.keys().hasAll(['id', 'numericId', 'title', 'status', 'startTime', 'endTime', 'contractAddress']) &&
             data.keys().hasOnly(['id', 'numericId', 'title', 'description', 'status', 'startTime', 'endTime', 'contractAddress', 'totalVotersRegistered', 'totalVotesCast', 'constituencyIds']) &&
             data.id is string && data.id.size() <= 64 &&
             data.numericId is int &&
             data.title is string && data.title.size() <= 200 &&
             data.status in ['draft', 'active', 'paused', 'concluded'] &&
             data.startTime is int &&
             data.endTime is int &&
             data.contractAddress is string && data.contractAddress.size() <= 42;
    }

    function isValidConstituency(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'state', 'totalElectors']) &&
             data.keys().hasOnly(['id', 'code', 'name', 'state', 'totalElectors', 'turnoutCount']) &&
             data.id is string && data.id.size() <= 64 &&
             data.code is string && data.code.size() <= 16 &&
             data.name is string && data.name.size() <= 100 &&
             data.state is string && data.state.size() <= 100 &&
             data.totalElectors is int;
    }

    function isValidCandidate(data) {
      return data.keys().hasAll(['id', 'numericId', 'constituencyId', 'name', 'partyName', 'voteCount']) &&
             data.keys().hasOnly(['id', 'numericId', 'constituencyId', 'name', 'partyName', 'partyAbbreviation', 'symbol', 'symbolColor', 'education', 'age', 'criminalCases', 'assets', 'voteCount']) &&
             data.id is string && data.id.size() <= 64 &&
             data.numericId is int &&
             data.constituencyId is string && data.constituencyId.size() <= 64 &&
             data.name is string && data.name.size() <= 120 &&
             data.partyName is string && data.partyName.size() <= 120 &&
             data.voteCount is int;
    }

    function isValidVoter(data) {
      return data.keys().hasAll(['id', 'epicId', 'name', 'constituencyId', 'isEligible', 'status']) &&
             data.keys().hasOnly(['id', 'epicId', 'name', 'gender', 'age', 'constituencyId', 'pollingStation', 'maskedMobile', 'isEligible', 'status', 'authorizedWallet', 'activeNullifier', 'ticketExpiry', 'votedAt']) &&
             data.id is string && data.id.size() <= 64 &&
             data.epicId is string && data.epicId.size() <= 32 &&
             data.name is string && data.name.size() <= 120 &&
             data.constituencyId is string && data.constituencyId.size() <= 64 &&
             data.isEligible is bool &&
             data.status in ['ELIGIBLE', 'AUTHORIZED', 'VOTED'];
    }

    function isValidOtpChallenge(data) {
      return data.keys().hasAll(['epicId', 'hmacHash', 'attemptsRemaining', 'expiresAt', 'isUsed']) &&
             data.keys().hasOnly(['epicId', 'hmacHash', 'attemptsRemaining', 'expiresAt', 'isUsed', 'createdAt', 'lastRequestedAt']) &&
             data.epicId is string && data.epicId.size() <= 32 &&
             data.hmacHash is string && data.hmacHash.size() == 64 &&
             data.attemptsRemaining is int && data.attemptsRemaining >= 0 && data.attemptsRemaining <= 3 &&
             data.expiresAt is int &&
             data.isUsed is bool;
    }

    function isValidAuditEvent(data) {
      return data.keys().hasAll(['id', 'timestamp', 'type', 'description', 'electionId']) &&
             data.keys().hasOnly(['id', 'timestamp', 'type', 'description', 'electionId', 'constituencyId', 'txHash', 'blockNumber', 'nullifier', 'isSimulated']) &&
             data.id is string && data.id.size() <= 64 &&
             data.timestamp is int &&
             data.type in ['ELECTION_STATE', 'CANDIDATE_REGISTERED', 'OTP_ISSUED', 'AUTHORIZATION_SIGNED', 'VOTE_CAST', 'NULLIFIER_SPENT', 'ADMIN_ACTION', 'TRANSACTION_RECOVERY'] &&
             data.description is string && data.description.size() <= 500 &&
             data.electionId is int;
    }

    function isValidPreferencePoll(data) {
      return data.keys().hasAll(['id', 'title', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 64 &&
             data.title is string && data.title.size() <= 200 &&
             data.status in ['open', 'closed'] &&
             data.createdAt is int;
    }

    // Collections rules

    // 1. Elections: Public read, authorized officer write
    match /elections/{electionId} {
      allow read: if isValidId(electionId);
      allow list: if true;
      allow create, update: if isValidId(electionId) && isAdmin() && isValidElection(request.resource.data);
      allow delete: if isAdmin() && isValidId(electionId);
    }

    // 2. Constituencies: Public read, authorized officer write
    match /constituencies/{constituencyId} {
      allow read: if isValidId(constituencyId);
      allow list: if true;
      allow create, update: if isValidId(constituencyId) && isAdmin() && isValidConstituency(request.resource.data);
      allow delete: if isAdmin() && isValidId(constituencyId);
    }

    // 3. Candidates: Public read, authorized officer write
    match /candidates/{candidateId} {
      allow read: if isValidId(candidateId);
      allow list: if true;
      allow create, update: if isValidId(candidateId) && isAdmin() && isValidCandidate(request.resource.data);
      allow delete: if isAdmin() && isValidId(candidateId);
    }

    // 4. Voters: Protected elector roll (legacy transitional). Bulk listing restricted to admin officers; direct client tampering blocked.
    match /voters/{voterId} {
      allow read: if isValidId(voterId) && (isAdmin() || (isSignedIn() && request.auth.uid == voterId));
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(voterId) && isValidVoter(request.resource.data);
      allow delete: if isAdmin() && isValidId(voterId);
    }

    // 4b. Voter Profiles (Phase 02): Identity records. Read restricted to self or admin; write locked from client SDK.
    match /voter_profiles/{profileId} {
      allow read: if isValidId(profileId) && (isAdmin() || (isSignedIn() && request.auth.uid == profileId));
      allow list: if isAdmin();
      allow write: if false; // Server-only management via Firebase Admin SDK
    }

    // 4c. Voter Election Participation (Phase 02): Per-election tracking. Write locked from client SDK.
    match /voter_election_participation/{partId} {
      allow read: if isValidId(partId) && (isAdmin() || isSignedIn());
      allow list: if isAdmin();
      allow write: if false; // Server-only management
    }

    // 4d. Biometric Enrollment Metadata (Phase 02): Strictly confidential metadata. Direct client SDK read/write prohibited.
    match /biometric_enrollments/{enrollId} {
      allow read, write: if false; // Authoritative backend only
    }

    // 4e. Anonymous Ballots (Phase 02): Confidential ballot receipts; direct write locked from client SDK.
    match /ballots/{ballotId} {
      allow read: if isValidId(ballotId) && (isAdmin() || isSignedIn());
      allow list: if isAdmin();
      allow write: if false; // Authoritative backend atomic recording only
    }

    // 4f. Authority Accounts (Phase 02): RBAC metadata. Read self or admin; write locked.
    match /authority_accounts/{accountId} {
      allow read: if isSignedIn() && (request.auth.uid == accountId || isAdmin());
      allow list: if isAdmin();
      allow write: if false; // Server-only provisioning
    }

    // 4g. Manual Physical-ID Exceptions (Phase 06): Strictly confidential exception records.
    match /manual_id_exceptions/{exceptionId} {
      allow read, write: if false; // Authoritative backend only
    }

    // 4h. Voting Sessions (Phase 08): Server-authoritative session records.
    match /voting_sessions/{sessionId} {
      allow read, write: if false; // Authoritative backend only
    }

    // 5. OTP Challenges: Strictly server-side HMAC challenges; client direct read/write prohibited.
    match /otp_challenges/{epicId} {
      allow read, write: if false;
    }

    // 6. Audit Events: Public read for transparency; creation strictly requires verified admin officer
    match /audit_events/{eventId} {
      allow read: if isValidId(eventId);
      allow list: if true;
      allow create: if isValidId(eventId) && isAdmin() && isValidAuditEvent(request.resource.data);
      allow update, delete: if false; // Strict immutability for election audit logs
    }

    // 7. Admins: Read by authenticated admin, write locked
    match /admins/{adminUid} {
      allow read: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow write: if false;
    }

    // 8. Historical 2024 Constituencies & Results: Strictly READ-ONLY for public visitors and client SDK
    match /historical_constituencies_2024/{constituencyId} {
      allow read: if isValidId(constituencyId);
      allow list: if true;
      allow write: if false; // Protected from client modification; populated via server import pipeline
    }

    // 8a. Historical Election Data Archive (Phase 10): Strictly READ-ONLY for public visitors and client SDK
    match /historical_archive/{archiveId} {
      allow read: if isValidId(archiveId);
      allow list: if true;
      allow write: if false; // Protected from client modification; populated via server import pipeline

      match /{document=**} {
        allow read: if true;
        allow write: if false;
      }
    }

    // 9. Political Parties Directory: Strictly READ-ONLY from client SDK
    match /political_parties/{partyCode} {
      allow read: if isValidId(partyCode);
      allow list: if true;
      allow write: if false;
    }

    // 10. Preference Polls Configuration: Public read, admin-managed
    match /preference_polls/{pollId} {
      allow read: if isValidId(pollId);
      allow list: if true;
      allow create, update: if isAdmin() && isValidId(pollId) && isValidPreferencePoll(request.resource.data);
      allow delete: if isAdmin() && isValidId(pollId);

      // Subcollection: Poll Responses
      // Read own response only; write is processed via trusted server transaction to enforce 1 vote per user
      match /responses/{userId} {
        allow read: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow list: if isAdmin();
        allow write: if false; // Must be processed server-side atomically
      }

      // Subcollection: Poll Aggregates
      // Read-only to public; updated exclusively by authoritative server transaction
      match /aggregates/{aggId} {
        allow read: if isValidId(aggId);
        allow list: if true;
        allow write: if false;
      }
    }

    // 11. Protected Server-Only Collections: Strictly denied to client SDK
    match /manual_id_exceptions/{document=**} {
      allow read, write: if false;
    }

    match /voting_sessions/{document=**} {
      allow read, write: if false;
    }
  }
}
