# ==============================================================================
# BlockBallot — Environment Configuration Specification (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - DO NOT COMMIT REAL CREDENTIALS, PRIVATE KEYS, OR TOKENS TO SOURCE CONTROL.
# - Production startup enforces fail-closed validation: test/demo keys are strictly rejected.
# - All secrets below must be unique, high-entropy values outside local testing.
# - All lines in this template must remain empty placeholders.
# ==============================================================================

# Node Environment: 'development', 'test', or 'production'
NODE_ENV=

# Server Port (default: 3000)
PORT=

# Canonical Application URL for CORS origin restriction in production (e.g., https://vote.yourdomain.gov.in)
APP_URL=

# Dedicated Server ECDSA Private Key for signing EIP-712 VotingAuthorization tickets
# IN PRODUCTION: Required 66-character hex string starting with 0x. Deterministic test keys will be rejected!
# IN DEVELOPMENT: If omitted, a dedicated local demo key is used.
SERVER_AUTHORIZATION_SIGNER_KEY=

# High-entropy HMAC Secret for salting and hashing OTP challenges (HMAC-SHA256)
# IN PRODUCTION: Required string of >= 32 characters. Academic prototype fallback will be rejected!
SERVER_HMAC_SECRET=

# Server salt for pseudonymous voter nullifier derivation
# IN PRODUCTION: Required string. Academic prototype fallback will be rejected!
SERVER_COMMITMENT_SALT=

# Target Firestore Database ID (use '(default)' for root database or specific named database)
FIRESTORE_DATABASE_ID=

# Target Google Cloud / Firebase Project ID
GCLOUD_PROJECT=
FIREBASE_PROJECT_ID=

# Optional: Firebase Service Account Key JSON string for server-side Admin SDK credentials
# If omitted in production on GCP, Google Application Default Credentials will be used.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Local Firestore Emulator Host (for hermetic testing: e.g. 127.0.0.1:8088)
FIRESTORE_EMULATOR_HOST=

# Blockchain Deployment Guard: Set to 'true' only if intentionally deploying to a public chain.
# Accidental deployments to non-local networks without this flag are blocked.
ALLOW_PUBLIC_DEPLOYMENT=