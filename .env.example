# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BLOCKBALLOT SERVER CONFIGURATION
# High-entropy server secret used for HMAC-SHA256 OTP challenge generation
SERVER_HMAC_SECRET="REPLACE_WITH_HIGH_ENTROPY_SERVER_HMAC_SECRET_64_CHAR"

# Dedicated server-side ECDSA private key for signing EIP-712 VotingAuthorization tickets
SERVER_AUTHORIZATION_SIGNER_KEY=replace_with_new_private_key

# Server salt for pseudonymous voter nullifier derivation
SERVER_COMMITMENT_SALT="REPLACE_WITH_RANDOM_SERVER_COMMITMENT_SALT_STRING"

# Firestore database ID configured for this project
FIRESTORE_DATABASE_ID="ai-studio-565633a9-76eb-4419-9891-05e6de180d7c"
