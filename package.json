{
  "name": "blockballot-evoting-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/test/*.test.ts",
    "test:integration": "tsx scripts/run-blockchain-integration.ts",
    "benchmark": "tsx scripts/benchmark-performance.ts",
    "admin:seed": "tsx scripts/seed-demo-admin.ts",
    "officers:seed": "tsx scripts/seed-demo-officers.ts",
    "voters:cleanup": "tsx scripts/cleanup-legacy-demo-voters.ts",
    "model:migrate": "tsx scripts/inspect-and-migrate-data-model.ts",
    "node:start": "hardhat --config hardhat.config.cjs node --hostname 127.0.0.1 --port 8545",
    "contract:deploy": "tsx scripts/deploy.ts",
    "emulator:start": "firebase emulators:start --only firestore",
    "emulator:test": "firebase emulators:exec --only firestore \"tsx --test src/test/phase7a2_emulator_integration.test.ts\""
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "firebase": "^11.4.0",
    "firebase-admin": "^14.5.0",
    "hardhat": "^3.21.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
