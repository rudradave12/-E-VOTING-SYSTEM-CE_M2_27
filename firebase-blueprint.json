{
  "entities": {
    "Election": {
      "title": "Election",
      "description": "National or legislative election metadata and lifecycle status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "numericId": { "type": "integer" },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["draft", "active", "paused", "concluded"] },
        "startTime": { "type": "integer" },
        "endTime": { "type": "integer" },
        "contractAddress": { "type": "string", "maxLength": 42 },
        "totalVotersRegistered": { "type": "integer" },
        "totalVotesCast": { "type": "integer" }
      },
      "required": ["id", "numericId", "title", "status", "startTime", "endTime", "contractAddress"]
    },
    "Constituency": {
      "title": "Constituency",
      "description": "Parliamentary constituency electoral jurisdiction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 16 },
        "name": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "totalElectors": { "type": "integer" },
        "turnoutCount": { "type": "integer" }
      },
      "required": ["id", "code", "name", "state", "totalElectors"]
    },
    "Candidate": {
      "title": "Candidate",
      "description": "Contesting candidate and party affiliation record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "numericId": { "type": "integer" },
        "constituencyId": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 120 },
        "partyName": { "type": "string", "maxLength": 120 },
        "partyAbbreviation": { "type": "string", "maxLength": 16 },
        "symbol": { "type": "string", "maxLength": 64 },
        "symbolColor": { "type": "string", "maxLength": 16 },
        "education": { "type": "string", "maxLength": 120 },
        "age": { "type": "integer" },
        "criminalCases": { "type": "integer" },
        "assets": { "type": "string", "maxLength": 64 },
        "voteCount": { "type": "integer" }
      },
      "required": ["id", "numericId", "constituencyId", "name", "partyName", "voteCount"]
    },
    "VoterRecord": {
      "title": "VoterRecord",
      "description": "Synthetic elector roll record decoupled from ballot choices",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "epicId": { "type": "string", "maxLength": 32 },
        "name": { "type": "string", "maxLength": 120 },
        "gender": { "type": "string", "enum": ["M", "F", "O"] },
        "age": { "type": "integer" },
        "constituencyId": { "type": "string", "maxLength": 64 },
        "pollingStation": { "type": "string", "maxLength": 200 },
        "maskedMobile": { "type": "string", "maxLength": 32 },
        "isEligible": { "type": "boolean" },
        "status": { "type": "string", "enum": ["ELIGIBLE", "AUTHORIZED", "VOTED"] },
        "authorizedWallet": { "type": "string", "maxLength": 42 },
        "votedAt": { "type": "integer" }
      },
      "required": ["id", "epicId", "name", "constituencyId", "isEligible", "status"]
    },
    "OtpChallenge": {
      "title": "OtpChallenge",
      "description": "Short-lived persistent HMAC-SHA256 OTP authentication challenge",
      "type": "object",
      "properties": {
        "epicId": { "type": "string", "maxLength": 32 },
        "hmacHash": { "type": "string", "maxLength": 66 },
        "attemptsRemaining": { "type": "integer" },
        "expiresAt": { "type": "integer" },
        "isUsed": { "type": "boolean" },
        "createdAt": { "type": "integer" },
        "lastRequestedAt": { "type": "integer" }
      },
      "required": ["epicId", "hmacHash", "attemptsRemaining", "expiresAt", "isUsed"]
    },
    "AuditEvent": {
      "title": "AuditEvent",
      "description": "Immutable audit log event for electoral transparency",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "integer" },
        "type": { "type": "string", "enum": ["ELECTION_STATE", "CANDIDATE_REGISTERED", "OTP_ISSUED", "AUTHORIZATION_SIGNED", "VOTE_CAST", "NULLIFIER_SPENT"] },
        "description": { "type": "string", "maxLength": 500 },
        "electionId": { "type": "integer" },
        "constituencyId": { "type": "integer" },
        "txHash": { "type": "string", "maxLength": 66 },
        "blockNumber": { "type": "integer" },
        "nullifier": { "type": "string", "maxLength": 66 },
        "isSimulated": { "type": "boolean" }
      },
      "required": ["id", "timestamp", "type", "description", "electionId"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Commission administrative officer authorization record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["officer", "commissioner"] },
        "createdAt": { "type": "integer" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/elections/{electionId}": {
      "schema": { "$ref": "#/entities/Election" },
      "description": "Global parliamentary elections collection"
    },
    "/constituencies/{constituencyId}": {
      "schema": { "$ref": "#/entities/Constituency" },
      "description": "Electoral constituencies collection"
    },
    "/candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/Candidate" },
      "description": "Nominated election candidates"
    },
    "/voters/{voterId}": {
      "schema": { "$ref": "#/entities/VoterRecord" },
      "description": "Synthetic elector roll registry with zero ballot data"
    },
    "/otp_challenges/{epicId}": {
      "schema": { "$ref": "#/entities/OtpChallenge" },
      "description": "Server-side persistent OTP challenge records"
    },
    "/audit_events/{eventId}": {
      "schema": { "$ref": "#/entities/AuditEvent" },
      "description": "Public immutable cryptographic audit log"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authorized election commission returning officers"
    }
  }
}
